/*
 * ROFI color theme
 *
 * Material layout with custom orange palette
 */

* {
    base00: #1d1309;
    base01: #1d1309;
    base02: #1d1309;
    base03: #1d1309;
    base04: #fd9201;
    base05: #fd9201;
    base06: #fd9201;
    base07: #ffffff;
    base08: #ff6b6b;
    base09: #fd9201;
    base0A: #fd9201;
    base0B: #fd9201;
    base0C: #fd9201;
    base0D: #fd9201;
    base0E: #fd9201;
    base0F: #fd9201;

    spacing: 0;
    background-color: transparent;

    font: "GohuFont uni11 Nerd Font Mono 16";
}

window {
    transparency: "real";
    background-color: #1d1309;
}

mainbox {
    children: [inputbar, message, mode-switcher, listview];
    spacing: 15px;
    padding: 15px 0;
    border: 1px;
    border-color: @base0D;
}

inputbar {
    padding: 0 15px;
    children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
    text-color: @base0D;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0 1ch 0 0;
    text-color: @base0D;
}

entry {
    text-color: @base05;
}

case-indicator {
    text-color: @base0F;
}

mode-switcher,
message {
    border: 1px 0;
    border-color: @base0D;
}

button,
textbox {
    background-color: @base03;
    text-color: @base05;
    padding: 5px;
}

button selected {
    background-color: @base0D;
    text-color: @base00;
}

listview {
    scrollbar: true;
    margin: 0 10px 0 30px;
}

scrollbar {
    background-color: @base03;
    handle-color: @base0D;
    handle-width: 10px;
    border: 0 1px;
    border-color: @base0D;
    margin: 0 0 0 20px;
}

element {
    padding: 5px;
    spacing: 5px;
    highlight: bold underline;
    children: [element-text];
}

element-text,
element-icon {
    background-color: inherit;
    text-color: inherit;
    foreground-color: inherit;
}

element normal {
    background-color: transparent;
}

element selected {
    background-color: @base0D;
}

element alternate {
    /* background-color: @base03; */
}

element normal normal,
element alternate normal {
    text-color: @base05;
}

element selected normal {
    text-color: @base00;
}

element normal urgent,
element selected urgent,
element alternate urgent {
    text-color: @base0F;
}

element normal active,
element selected active,
element alternate active {
    text-color: @base0B;
}